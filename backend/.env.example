# Copy to .env and fill in. Never commit .env.
# Run with:  npm run start:local   (= node --env-file=.env server.js)
#
# THIS FILE IS COMMITTED. Put placeholders here, never a real key.
# Real keys go in .env (gitignored) or your host's dashboard.

PORT=8787

# anthropic | openai | (empty for the echo provider, which needs no key)
PROVIDER=openai

# Provider credentials — these stay on the server, never in the extension.
# Get an OpenAI key at https://platform.openai.com/api-keys — it starts "sk-".
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=sk-your-openai-key-here

# Optional. Only set this to reach an OpenAI-COMPATIBLE service instead of
# OpenAI itself (a self-hosted gateway, or Gemini's compat endpoint). Leave it
# unset for OpenAI proper.
# OPENAI_BASE_URL=

# Optional model override; the OpenAI adapter defaults to gpt-4o-mini.
MODEL=gpt-4o-mini

# Optional: require the extension to send `Authorization: Bearer <token>`.
# Paste the same value into ClariWord → Settings → Access token.
# Generate one with:  openssl rand -hex 32
ACCESS_TOKEN=

# Lock CORS down in production to your published extension id, e.g.
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=20
