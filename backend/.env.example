# Copy to .env and fill in. Never commit .env.
# Run with:  npm run start:local   (= node --env-file=.env server.js)
#
# THIS FILE IS COMMITTED. Put placeholders here, never a real key.
# Real keys go in .env (gitignored) or your host's dashboard.

PORT=8787

# anthropic | openai | (empty for the echo provider, which needs no key)
#
# Gemini is reached through its OpenAI-compatible endpoint, so it uses
# PROVIDER=openai plus OPENAI_BASE_URL below — there is no "gemini" value.
PROVIDER=openai

# Provider credentials — these stay on the server, never in the extension.
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=your-gemini-api-key-here

# Point the OpenAI-compatible client at Gemini.
# Omit this line entirely to talk to OpenAI proper.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional model override; each provider has a sensible default.
# For Gemini, set this explicitly — the adapter's default (gpt-4o-mini)
# is not a Gemini model.
MODEL=gemini-2.5-flash

# Optional: require the extension to send `Authorization: Bearer <token>`.
# Paste the same value into ClariWord → Settings → Access token.
ACCESS_TOKEN=

# Lock CORS down in production to your published extension id, e.g.
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=20
